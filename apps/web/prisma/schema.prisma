generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
}

enum CardType {
  BUG
  FEATURE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Board {
  id   String @id @default(uuid())
  name String

  prefix       String?
  nextSequence Int     @default(1)

  users     BoardUser[]
  createdAt DateTime    @default(now())
  columns   Column[]
}

model BoardUser {
  boardId String
  userId  String

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([boardId, userId])
}

model Column {
  id        String    @id @default(uuid())
  name      String
  position  Int
  isBacklog Boolean   @default(false)
  boardId   String
  dueDate   DateTime?
  cards     Card[]
  board     Board     @relation(fields: [boardId], references: [id])
}

model Card {
  id          String    @id @default(uuid())
  title       String
  description String?
  type        CardType
  sequenceNum Int       @default(0)
  priority    Priority  @default(MEDIUM)
  dueDate     DateTime?

  tags String[] @default([])

  parentId String?
  parent   Card?   @relation("CardToSubtasks", fields: [parentId], references: [id])
  subtasks Card[]  @relation("CardToSubtasks")

  columnId   String
  assigneeId String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  position   Int

  column        Column         @relation(fields: [columnId], references: [id])
  assignee      User?          @relation(fields: [assigneeId], references: [id])
  comments      Comment[]
  attachments   Attachment[]
  notifications Notification[]
}

model AuditLog {
  id        String   @id @default(uuid())
  entity    String
  entityId  String
  action    String
  payload   Json
  createdAt DateTime @default(now())
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String
  keys      Json
  createdAt DateTime @default(now())
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  active    Boolean  @default(true)
  updatedAt DateTime @updatedAt
  avatar    String?

  boardUsers    BoardUser[]
  assignedCards Card[]
  comments      Comment[]
  attachments   Attachment[]
  notifications Notification[]
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String // E.g., "New Mention"
  body      String? // E.g., "Isaac mentioned you in PBN-12"
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  // 👇 ADDED FOR MENTIONS:
  actorId String? // The ID of the user who @ mentioned them
  cardId  String? // The ID of the card they were mentioned in
  boardId String? // The board that card lives on — lets the client deep-link without an extra lookup
  card    Card?   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  // Your existing optimized indexes!
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId], where: { read: false }, map: "unread_notifications_idx")
}

model Comment {
  id        String   @id @default(uuid())
  text      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  userId String
  user   User   @relation(fields: [userId], references: [id])

  cardId String
  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)
}

// Add this brand new model to the bottom of the file:
model Attachment {
  id     String @id @default(uuid())
  cardId String
  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  fileName  String
  fileUrl   String
  fileType  String
  sizeBytes Int    @default(0)

  createdAt DateTime @default(now())

  @@index([cardId])
}
